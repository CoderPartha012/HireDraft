{
  "name": "hiredraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "llm": "cd llm-gateway && .venv\\Scripts\\python.exe -m uvicorn app:app --host 127.0.0.1 --port 8000 --no-access-log",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write app components e2e next.config.mjs postcss.config.mjs playwright.config.js src/server/http.js",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "lucide-react": "^1.46.0",
    "motion": "^13.4.1",
    "next": "^16.3.5",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
